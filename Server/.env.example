# MaintainerAI — Environment Variables
# Fill in your values and rename this file to .env

# General
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Ports
GATEWAY_PORT=8000
AI_SERVICE_PORT=8002
GITHUB_SERVICE_PORT=8003
REPORT_SERVICE_PORT=8004

# LLM — used by AI Service (Gemini preferred, OpenAI as fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub App — used by GitHub Service
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Your GitHub App's slug (visible in the App URL: github.com/apps/<slug>)
GITHUB_APP_SLUG=

# MongoDB
GITHUB_MONGO_URI=mongodb://localhost:27017/maintainer_ai_github
REPORT_MONGO_URI=mongodb://localhost:27017/maintainer_ai_reports

# Service URLs
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8002
GITHUB_SERVICE_URL=http://localhost:8003
REPORT_SERVICE_URL=http://localhost:8004
